# Copy to .env and fill in. Keep .env out of version control.
#
# Locally (go run ./cmd/server) this file is loaded automatically by godotenv.
# In Docker the same file is passed with env_file / --env-file. Real
# environment variables always win over the values here.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

HTTP_PORT=8080

# Where .torrent files are written. Inside the container this is the mount
# point; on the host it is whatever your download client watches.
TORRENT_FILES_DIR=/torrents

# SQLite database file. Must live on a mounted volume to survive a redeploy.
DB_PATH=/data/app.db

# Display timezone. Timestamps are always stored in UTC.
TZ=Europe/Kyiv

# debug | info | warn | error
LOG_LEVEL=info

# Maximum titles accepted in one batch submission.
BATCH_MAX_LINES=100

# HTTP basic auth for the UI. Both must be set to enable it; leave both empty
# for an unauthenticated LAN-only deployment.
AUTH_USER=
AUTH_PASSWORD=

# Set false to disable duplicate rejection globally. Individual requests can
# always be forced from the UI instead.
DUPLICATE_CHECK_ENABLED=true

# How many requests are searched at once. One request queries every tracker in
# parallel, so this is not a per-tracker number; per-tracker load stays bounded
# by that tracker's RPS.
WORKERS=5

# Container user. On Synology, set these to the owner of the mounted shares —
# otherwise the container cannot write to them. Find them with `id <user>`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Trackers
# ---------------------------------------------------------------------------

# Every title is searched on every tracker listed here, and the best release
# across all of them wins. Each slug also selects a built-in preset — the paths,
# form fields and selectors of that tracker — so nothing else is needed to add a
# supported site beyond its credentials.
#
# Known presets: toloka, mazepa, torrentpier (the generic engine).
TRACKERS=toloka,mazepa

# --- toloka.to -------------------------------------------------------------
TRACKER_TOLOKA_LOGIN=
TRACKER_TOLOKA_PASSWORD=

# Lower wins. Priority only separates releases that are equally good: quality
# tier, then codec, then priority, then size. A 2160p release on the second
# tracker still beats a 1080p one on the first.
TRACKER_TOLOKA_PRIORITY=1

# Per-request timeout in seconds.
TRACKER_TOLOKA_TIMEOUT_SECONDS=30

# Request rate for this tracker, shared by all workers. Raising it makes the
# service look less like a browser and more like a scraper.
TRACKER_TOLOKA_RPS=1

# Skip releases larger than this many bytes. 0 = unlimited.
# Example: 64424509440 = 60 GiB
TRACKER_TOLOKA_MAX_SIZE_BYTES=0

# The preset supplies https://toloka.to; override only to reach a mirror.
# TRACKER_TOLOKA_BASE_URL=https://toloka.to

# --- mazepa.to -------------------------------------------------------------
TRACKER_MAZEPA_LOGIN=
TRACKER_MAZEPA_PASSWORD=
TRACKER_MAZEPA_PRIORITY=2
TRACKER_MAZEPA_TIMEOUT_SECONDS=30
TRACKER_MAZEPA_RPS=1
TRACKER_MAZEPA_MAX_SIZE_BYTES=0

# --- per-tracker overrides -------------------------------------------------
# Override only if the default Chrome string stops working.
# TRACKER_<SLUG>_USER_AGENT=

# A tracker not covered by a preset: pick the closest engine and correct it.
# TRACKER_OTHER_PRESET=torrentpier
# TRACKER_OTHER_BASE_URL=https://other.example

# Paths, form fields and selectors as a JSON object, merged over the preset key
# by key. Set this only when a tracker changes its markup and the parser stops
# finding rows. The toloka preset, spelled out:
# TRACKER_TOLOKA_EXTRA_OPTIONS={"tracker_path":"/tracker.php","login_path":"/login.php","login_username_field":"username","login_password_field":"password","login_submit_field":"login","login_submit_value":"Вхід","login_extra_fields":{"autologin":"1"},"search_query_field":"nm","logged_in_selector":"a[href*='logout']","logged_out_selector":"a[href*='mode=register']","result_row_selector":"table.forumline tr.prow1, table.forumline tr.prow2","topic_link_selector":"td.topictitle a","download_link_selector":"a[href*='download.php?id=']","forum_link_selector":"a[href*='tracker.php?f=']","size_cell_index":6}
#
# ...and the mazepa/TorrentPier preset:
# TRACKER_MAZEPA_EXTRA_OPTIONS={"tracker_path":"/tracker.php","login_path":"/login.php","login_username_field":"login_username","login_password_field":"login_password","login_submit_field":"login","login_submit_value":"Увійти","search_query_field":"nm","logged_in_selector":"a[href*='logout']","logged_out_selector":"#register_link","result_row_selector":"#forum_table tbody tr","topic_link_selector":"a[href*='topic-']","download_link_selector":"a[href*='dl.php?id=']","forum_link_selector":"a[href*='forum-']","size_cell_index":5}

# --- legacy single-tracker layout ------------------------------------------
# Leaving TRACKERS unset falls back to one tracker configured on unprefixed
# variables (TRACKER_NAME, TRACKER_BASE_URL, TRACKER_LOGIN, TRACKER_PASSWORD,
# TRACKER_WORKERS, …). Existing deployments keep working; new ones should use
# the list above.

# ---------------------------------------------------------------------------
# Retry policy (transient failures only: network, timeouts, 5xx, 429)
# ---------------------------------------------------------------------------

RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=3
RETRY_MAX_BACKOFF_SECONDS=60

# ---------------------------------------------------------------------------
# Trakt.tv watchlist sync
# ---------------------------------------------------------------------------

# A background worker polls a trakt.tv watchlist and queues every new movie for
# download, exactly as if it had been typed into the form. Off by default.
TRAKT_ENABLED=false

# Credentials of the trakt application whose OAuth grant the Emby/Jellyfin trakt
# plugin holds. They must be the pair that issued the plugin's refresh token —
# for a stock plugin install, the plugin's own compiled-in pair:
# https://github.com/jellyfin/jellyfin-plugin-trakt/blob/master/Trakt/Api/TraktURIs.cs#L6
# Use your own only if you re-authorized the plugin against your own application
# (https://trakt.tv/oauth/applications).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# The jellyfin holding that plugin. This service reads the access token out of
# the plugin's configuration over the API, and writes a refreshed one back, so
# no access to jellyfin's config volume is needed.
JELLYFIN_HOST=http://jellyfin:8096

# An API key from Dashboard -> Advanced -> API Keys.
JELLYFIN_API_KEY=

# Which linked jellyfin user's trakt account to sync, by LinkedMbUserId. Leave
# it unset unless several users have linked trakt accounts to the plugin; the
# first account carrying a token is used then.
JELLYFIN_USER_ID=

# JELLYFIN_TIMEOUT_SECONDS=30

# How often the watchlist is polled. The first sync runs at startup.
TRAKT_INTERVAL_MINUTES=15

# The watchlist is read newest-addition-first and the walk stops at the last
# entry already processed, so a steady state costs one page. PAGE_LIMIT is the
# page size (max 1000) and MAX_PAGES bounds a single run — a watchlist longer
# than PAGE_LIMIT × MAX_PAGES is imported over several runs.
TRAKT_PAGE_LIMIT=100
TRAKT_MAX_PAGES=10

TRAKT_TIMEOUT_SECONDS=30

# Search for "Extraction 2020" rather than "Extraction". On by default: the year
# is what separates two films sharing a title, and without it the duplicate
# check would reject a remake of something already downloaded. Turn it off if a
# tracker's search matches titles literally and the year costs matches.
TRAKT_QUERY_WITH_YEAR=true

# Override only to reach a proxy or a test double.
# TRAKT_BASE_URL=https://api.trakt.tv

# Healthchecks.io signalling for the sync. Nothing runs in front of a background
# worker, so the way you learn it has stopped is a monitor noticing the ping that
# never arrived. Leave the UUID empty and no signals are sent at all.
#
# Every successful sync pings <base>/<uuid>. Failures are counted instead of
# reported: the first four in a row are logged and left to the next run, and only
# the fifth pings <base>/<uuid>/fail. A success resets the count.
#
# Set the check's period to TRAKT_INTERVAL_MINUTES and give it a grace period of
# a few intervals, so a single slow run does not raise an alarm.
TRAKT_HEALTHCHECK_UUID=

# Point this at your own installation if you self-host healthchecks.
# TRAKT_HEALTHCHECK_BASE_URL=https://hc-ping.com
